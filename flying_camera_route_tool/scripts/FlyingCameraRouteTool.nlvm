/**Flying Camera Route Tool NL2 Script**
	Author: Red-Thirten
	Date: 12/12/2025
	License: GNU GPLv3 - See LICENSE for more details.
	Description: 	Allows the user to setup and manage multiple camera waypoints based on their viewpoint during runtime
					that they can later fly through for video recording purposes.
*/

import com.nolimitscoaster.Script;
import com.nolimitscoaster.SceneObject;
import com.nolimitscoaster.SceneObjectElement;
import com.nolimitscoaster.ExternalRideView;
import com.nolimitscoaster.TrackTrigger;
import com.nolimitscoaster.TrackTriggerListener;
import com.nolimitscoaster.Train;
import com.nolimitscoaster.Button;
import com.nolimitscoaster.Tools;
import com.nolimitscoaster.ResourcePath;
import nlvm.math3d.*;
import nlvm.util.Vector;

import obj.*;
import util.*;

public class FlyingCameraRouteTool extends Script implements TrackTriggerListener{
	protected String SCRIPT_NAME = "Flying Camera Route Tool";						// Script name for debugging
	protected String CAMERA_ELEM_PREFIX = "camera";									// Prefix of camera element names
	protected String COUNTDOWN_ELEM_NAME = "countdown";								// Name of countdown element
	private static final Vector4f START_COLOR = new Vector4f(0.f, 0.9f, 0.f, 1.f);	// Color of start waypoint camera
	private static final Vector4f HARD_COLOR = new Vector4f(0.75f, 0.f, 1.f, 1.f);	// Color of hard waypoint cameras
	private static final Vector4f SOFT_COLOR = new Vector4f(0.f, 0.75f, 1.f, 1.f);	// Color of soft waypoint cameras
	private static final Vector4f PREVIEW_COLOR = new Vector4f(0.8f, 0.f, 0.f, 0.5f);// Color of preview camera
	private static final int CAM_IND_START = 0;										// Camera indicator texture index for Start
	private static final int CAM_IND_HARD_A = 1;									// Camera indicator texture index for Hard A
	private static final int CAM_IND_HARD_B = 2;									// Camera indicator texture index for Hard B
	private static final int CAM_IND_SOFT_A = 3;									// Camera indicator texture index for Soft A
	private static final int CAM_IND_SOFT_B = 4;									// Camera indicator texture index for Soft B
	private static final int CAM_IND_PREVIEW = 5;									// Camera indicator texture index for Preview
	private static final float BUTTON_TIMEOUT = 0.25f;								// Time before accepting another button press (ie. button is held down)
	private static final int TIMEOUT_BUTTONS = 										// Bitmask of buttons to monitor for timeout purposes
		ButtonListener.NEXT_CAR |
		ButtonListener.NEXT_SEAT |
		ButtonListener.NEXT_TRAIN |
		ButtonListener.ACTION;
	
	private float FLY_TIME_INCR = 1.f;												// Default fly time increment (gets set once during init)
	private float ROLL_BUTTON_TIMEOUT = 0.001f;										// Default time before accepting another key press for rolling camera (gets set once during init)
	private float ROTATION_INCR = (float) Math.toRadians(2);						// Default rotation increment in radians (gets set once during init)
	
	private SceneObject sco;
	private SceneObjectElement cameraStart, cameraA, cameraB, cameraPreview, countdown;
	private ExternalRideView flyView;
	private RayCast rayStart, rayA, rayB;
	private Vector waypoints = new Vector();
	private Matrix4x4f curCameraMatrix = new Matrix4x4f();
	private Matrix4x4f prevCameraMatrix = new Matrix4x4f();
	private TrackTrigger coasterTrigger;
	private ButtonListener funcButtons, rollButtons;
	
	private int curPreview = -1;
	private int curWaypoint;
	private float timer = 0.f;
	private float flyTime = 3.f;
	private float[] flyTimes;
	private bool flying, preflight = false;
	private bool skipCountdown, waitForTrigger, averageFlyTimes, linearMode, firstInstructionsPrinted = false;
	
	// On initialization of Play simulation
	public bool onInit(){
		// Make sure only one tool is placed
		SceneObject[] scos = sim.getSceneObjectsWithName(SCRIPT_NAME);
		if (scos.length != 1){
			System.err.println(SCRIPT_NAME + ":\n\tOnly place ONE tool object in the editor, and make sure it is named \"" + SCRIPT_NAME + "\".");
			return false;
		}

		// Get and assign local SCO
		sco = SceneObjectTools.getSceneObjectForEntityId(
			sim,
			getParentEntityId(),
			SCRIPT_NAME
		);

		// Get fly time increment value from parameter
		Double flyTimeIncrParam = sco.getDoubleParameter("fly_time_incr");
		if (flyTimeIncrParam != null) FLY_TIME_INCR = Math.abs(flyTimeIncrParam.floatValue());
		// Get skip countdown param
		Boolean skipCountdownParam = sco.getBooleanParameter("skip_countdown");
		if (skipCountdownParam != null) skipCountdown = skipCountdownParam.boolValue();
		// Get rotation increment value from parameter
		Double rotationIncrParam = sco.getDoubleParameter("rotation_incr");
		if (rotationIncrParam != null && rotationIncrParam.floatValue() != 0){
			ROLL_BUTTON_TIMEOUT = BUTTON_TIMEOUT;
			ROTATION_INCR = (float) Math.toRadians(Math.abs(rotationIncrParam.doubleValue()));
		}
		// Get coaster trigger from parameter if specified
		coasterTrigger = sco.getTrackTriggerParameter("coaster_trigger");
		if (coasterTrigger != null) coasterTrigger.addTrackTriggerListener(this);

		// Get waypoint file path from parameter if specified
		ResourcePath waypointFilePath = sco.getResourcePathParameter("waypoint_file");
		if (waypointFilePath != null){
			waypoints = WaypointFile.decode(waypointFilePath);
			curPreview = waypoints.size() - 1;
			calcFlyTimes();
		}

		// Get and assign SCO elements
		cameraStart = SceneObjectTools.getElementForName(sco, CAMERA_ELEM_PREFIX + 0, SCRIPT_NAME);
		rayStart = new RayCast(cameraStart);
		cameraA = SceneObjectTools.getElementForName(sco, CAMERA_ELEM_PREFIX + 1, SCRIPT_NAME);
		rayA = new RayCast(cameraA);
		cameraB = SceneObjectTools.getElementForName(sco, CAMERA_ELEM_PREFIX + 2, SCRIPT_NAME);
		rayB = new RayCast(cameraB);
		cameraPreview = SceneObjectTools.getElementForName(sco, CAMERA_ELEM_PREFIX + 3, SCRIPT_NAME);
		countdown = SceneObjectTools.getElementForName(sco, COUNTDOWN_ELEM_NAME, SCRIPT_NAME);

		// Setup Button Listeners
		funcButtons = new ButtonListener(BUTTON_TIMEOUT, TIMEOUT_BUTTONS);
		rollButtons = new ButtonListener(ROLL_BUTTON_TIMEOUT, TIMEOUT_BUTTONS);

		// Setup External Ride View
		flyView = sim.createExternalRideView();
		flyView.setLabel(SCRIPT_NAME);
		flyView.setMorphingEnabled(false);

		// Setup preview cameras
		cameraStart.setEntityColor(START_COLOR);
		cameraStart.setTextureAnimationIndex(CAM_IND_START);
		cameraPreview.setEntityColor(PREVIEW_COLOR);
		cameraPreview.setTextureAnimationIndex(CAM_IND_PREVIEW);
		curCameraMatrix.initIdentity(); // Prevents 0 scale issues

		// Move SCO to the world origin to allow SCO Elements to be moved absolutely
		Matrix4x4f origin = new Matrix4x4f();
		origin.initIdentity();
		sco.setMatrix(origin);
		sco.setElementsVisible(false);

		return true;
	}
	
	// Prints instructions and current settings to the console
	private void printInstructions(){
		String averageFlyTimesStr = (averageFlyTimes) ? "On" : "Off";
		System.err.println("\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n");
		System.out.println("\t\t\t\t\t\t\t\t\t" + SCRIPT_NAME + "  |  Fly Time: " + flyTime + "s  |  Average Fly Times: " + averageFlyTimesStr);
		System.out.println("=====================================================================");
		System.out.println("| Place Waypoint: " + btnStr("c") + "  |  Place No-Stop Waypoint: " + btnStr("v") + "  |  Toggle Waypoint Type: Look at + " + btnStr("shift") + " + " + btnStr("t"));
		System.out.println("| Delete last Waypoint: " + btnStr("t") + "  |  Delete specific Waypoint: Look at + " + btnStr("t") + "  |  Delete All Waypoints: " + btnStr("ctrl") + " + " + btnStr("t"));
		System.out.println("| Cycle Waypoint previews: " + btnStr("ctrl") + " + " + btnStr("c") + " or " + btnStr("v") + "  |  Roll Waypoint: Look at + " + btnStr("shift") + " + " + btnStr("c") + " or " + btnStr("v"));
		System.out.println("| Change Fly Time between Waypoints: " + btnStr("ctrl") + " + " + btnStr("shift") + " + " + btnStr("c") + " or " + btnStr("v"));
		System.out.println("| Toggle Averaging of Fly Times: " + btnStr("ctrl") + " + " + btnStr("shift") + " + " + btnStr("t") + "  |  Export Waypoints: " + btnStr("ctrl") + " + " + btnStr("shift") + " + " + btnStr("click"));
		System.out.println("================== (Remember to close this console before recording) ==================");
	}
	
	// Given the default key name, returns the assigned keys/buttons as a string
	private String btnStr(String keyNameDefault){
		int button = -1;
		if (keyNameDefault.equals("c")) button = Button.NEXT_CAR;
		else if (keyNameDefault.equals("v")) button = Button.NEXT_SEAT;
		else if (keyNameDefault.equals("t")) button = Button.NEXT_TRAIN;
		else if (keyNameDefault.equals("ctrl")) button = Button.FLY_SLOWER;
		else if (keyNameDefault.equals("shift")) button = Button.FLY_FASTER;
		else if (keyNameDefault.equals("click")) button = Button.ACTION;
		return Button.getAssignedKeyString(button);
	}
	
	// Runs every frame to update preview cameras that need to be on screen
	private void updatePreviewCameras(float tick){
		sco.setElementsVisible(false);
		if (waypoints.size() >= 3){
			setPreviewCameraProperties(cameraA, rayA, (Matrix4x4f) waypoints.elementAt(curPreview - 1));
		}
		if (waypoints.size() >= 2){
			setPreviewCameraProperties(cameraB, rayB, (Matrix4x4f) waypoints.elementAt(curPreview));
			cameraPreview.setVisible(true);
			doWaypointFlights(tick, true);
		}
		if (waypoints.size() >= 1){
			setPreviewCameraProperties(cameraStart, rayStart, (Matrix4x4f) waypoints.elementAt(0));
			flyView.setEnterWarpPoint(cameraStart.getAbsoluteTranslation(), 1.5f); // Update fly view start properties
		}
	}
	
	// Updates the position, visibility, type, and ray of a given preview camera element
	private void setPreviewCameraProperties(SceneObjectElement camera, RayCast ray, Matrix4x4f matrix){
		camera.setMatrix(matrix); // Set position
		camera.setVisible(true); // Set visible
		ray.setPlanePoint(matrix.getTrans()); // Set ray
		if ( camera.getName().equals(CAMERA_ELEM_PREFIX + "0") ) return; // Start camera element is static in type
		else if ( isWaypointSoft(matrix) ){ // Set color and indicator of camera based on type and preview position
			camera.setEntityColor(SOFT_COLOR);
			if ( camera.getName().equals(CAMERA_ELEM_PREFIX + "1") ){
				camera.setTextureAnimationIndex(CAM_IND_SOFT_A);
			}
			else{
				camera.setTextureAnimationIndex(CAM_IND_SOFT_B);
			}
		}
		else{
			camera.setEntityColor(HARD_COLOR);
			if ( camera.getName().equals(CAMERA_ELEM_PREFIX + "1") ){
				camera.setTextureAnimationIndex(CAM_IND_HARD_A);
			}
			else{
				camera.setTextureAnimationIndex(CAM_IND_HARD_B);
			}
		}
	}
	
	// Returns if a waypoint matrix is soft
	private bool isWaypointSoft(Matrix4x4f matrix){
		return (matrix.elemAt(0,3) == 1.f) ? true : false;
	}
	
	// Returns the index of the waypoint in view, or, if none in view, the last index or -1 depending on the passed boolean
	private int getIndexOfWaypointInView(bool getLastIfNoView){
		if ( rayStart.isViewerLookingAt(0.5f) ){
			return 0;
		}
		else if ( rayA.isViewerLookingAt(0.5f) ){
			return curPreview - 1;
		}
		else if ( rayB.isViewerLookingAt(0.5f) ){
			return curPreview;
		}
		else if (getLastIfNoView){
			return waypoints.size() - 1;
		}
		else{
			return -1;
		}
	}

	private void calcFlyTimes(){
		int segments = Math.max(waypoints.size()-1, 0);
		flyTimes = new float[segments];
		float totalDist = 0.f;
		for (int i = 0; averageFlyTimes && i < segments; i++){ // Get total distance between waypoints if averaging fly times
			totalDist += Matrix4x4fMath.distance((Matrix4x4f) waypoints.elementAt(i), (Matrix4x4f) waypoints.elementAt(i+1));
		}
		for (int i = 0; i < segments; i++){ // Set fly times between waypoints (dependent if static or averaged)
			if (averageFlyTimes){
				float dist = Matrix4x4fMath.distance((Matrix4x4f) waypoints.elementAt(i), (Matrix4x4f) waypoints.elementAt(i+1));
				flyTimes[i] = dist / totalDist * (flyTime * flyTimes.length); // Dist % * Total Time
			}
			else{
				flyTimes[i] = flyTime;
			}
		}
	}

	private void addWaypoint(bool soft){
		Matrix4x4f view = new Matrix4x4f();
		sim.getViewMatrix(view);
		if (soft){ // Soft waypoint: put a flag in an unused part of the Matrix4x4f
			view.setElemAt(0,3, 1.f);
		}
		waypoints.addElement(view);
		curPreview = waypoints.size() - 1;
		calcFlyTimes();
	}

	private void rollWaypoint(bool left){
		int index = getIndexOfWaypointInView(false);
		if (index != -1){ // If player is looking at a waypoint...
			Matrix4x4f waypointMatrix = (Matrix4x4f) waypoints.elementAt(index);
			Vector3f waypointEuler = Matrix4x4fMath.matrixToEuler(waypointMatrix);
			if (left){
				waypointEuler.z += ROTATION_INCR;
			}
			else{
				waypointEuler.z -= ROTATION_INCR;
			}
			Matrix4x4fMath.eulerToMatrix(waypointEuler, waypointMatrix);
			waypoints.setElementAt(waypointMatrix, index); // Write the new matrix back to the waypoint list
		}
	}

	private void handleButtonPress(float tick){
		switch (
			funcButtons.getPressed() &
			(TIMEOUT_BUTTONS | ButtonListener.FLY_SLOWER | ButtonListener.FLY_FASTER) // Only check these buttons
		){
			// Place waypoints
			case ButtonListener.NEXT_CAR: // C
				addWaypoint(false);
				break;
			case ButtonListener.NEXT_SEAT: // V
				addWaypoint(true);
				break;
			
			// Cycle preview cameras
			case ButtonListener.FLY_SLOWER | ButtonListener.NEXT_CAR: // Ctrl + C
				if (waypoints.size() > 3 && curPreview > 2){
					curPreview--;
				}
				break;
			case ButtonListener.FLY_SLOWER | ButtonListener.NEXT_SEAT: // Ctrl + V
				if (waypoints.size() > 3 && curPreview < waypoints.size() - 1){
					curPreview++;
				}
				break;
			
			// Change time between waypoints
			case ButtonListener.FLY_SLOWER | ButtonListener.FLY_FASTER | ButtonListener.NEXT_CAR: // Ctrl + Shift + C
				if (flyTime - FLY_TIME_INCR > 0){
					flyTime -= FLY_TIME_INCR;
					calcFlyTimes();
				}
				printInstructions();
				break;
			case ButtonListener.FLY_SLOWER | ButtonListener.FLY_FASTER | ButtonListener.NEXT_SEAT: // Ctrl + Shift + V
				flyTime += FLY_TIME_INCR;
				calcFlyTimes();
				printInstructions();
				break;
			
			// Delete waypoint in view or last waypoint
			case ButtonListener.NEXT_TRAIN: // T
				if (curPreview > -1){ // Do nothing if no preview cameras
					waypoints.removeElement(waypoints.elementAt(getIndexOfWaypointInView(true)));
					if (curPreview == waypoints.size()) curPreview--;
					calcFlyTimes();
				}
				break;
			
			// Delete all waypoints
			case ButtonListener.FLY_SLOWER | ButtonListener.NEXT_TRAIN: // Ctrl + T
				waypoints.clear();
				curPreview = -1;
				calcFlyTimes();
				break;

			// Toggle waypoint softness
			case ButtonListener.FLY_FASTER | ButtonListener.NEXT_TRAIN: // Shift + T
				int index = getIndexOfWaypointInView(false);
				if (index != -1){ // If player is looking at a waypoint...
					Matrix4x4f waypointMatrix = (Matrix4x4f) waypoints.elementAt(index);
					if ( isWaypointSoft(waypointMatrix) ){
						waypointMatrix.setElemAt(0,3, 0.f);
					}
					else{
						waypointMatrix.setElemAt(0,3, 1.f);
					}
				}
				break;

			// Toggle average fly times
			case ButtonListener.FLY_SLOWER | ButtonListener.FLY_FASTER | ButtonListener.NEXT_TRAIN: // Ctrl + Shift + T
				averageFlyTimes = !averageFlyTimes;
				calcFlyTimes();
				printInstructions();
				break;
			
			// Export waypoints
			case ButtonListener.FLY_SLOWER | ButtonListener.FLY_FASTER | ButtonListener.ACTION: // Ctrl + Shift + Left Click
				System.err.println("\nCopy & save the following black text to a file (eg. `waypoints.txt`):");
				System.err.println("_______________________________________________________________________\n");
				System.out.print(WaypointFile.encode(waypoints));
				System.err.println("_______________________________________________________________________");
				System.err.println("\n^ Copy & save the black text above to a file (eg. `waypoints.txt`) ^");
				break;
		}

		switch (rollButtons.getPressed()){
			// Roll camera
			case ButtonListener.FLY_FASTER | ButtonListener.NEXT_CAR: // Shift + C
				rollWaypoint(true);
				break;
			case ButtonListener.FLY_FASTER | ButtonListener.NEXT_SEAT: // Shift + V
				rollWaypoint(false);
				break;
		}

		funcButtons.onNextFrame(tick);
		rollButtons.onNextFrame(tick);
	}

	private void doWaypointFlights(float tick, bool preview){
		if (curWaypoint >= flyTimes.length){ // End flight
			if (preview) curWaypoint = 0; // Restart flight
			// Else, do nothing; wait for player to leave fly view
		}
		else if (timer >= flyTimes[curWaypoint]){ // Next segment
			timer = 0.f;
			// Store the current camera matrix (after LERP'ing) to be used as the next flight's starting waypoint
			// because, due to small floating point calculation errors, the current matrix will slightly differ
			// from the true next waypoint matrix. Just using the next waypoint matrix causes a jerk in animation.
			prevCameraMatrix = curCameraMatrix.dup();
			curWaypoint++;
		}
		else{ // Flying segment
			// Get relevant waypoints for segment
			Matrix4x4f z = new Matrix4x4f();
			Matrix4x4f a = new Matrix4x4f();
			Matrix4x4f b = new Matrix4x4f();
			Matrix4x4f c = new Matrix4x4f();
			if (linearMode){
				a = (curWaypoint == 0) ? (Matrix4x4f) waypoints.elementAt(0) : prevCameraMatrix;
				b = (Matrix4x4f) waypoints.elementAt(curWaypoint + 1);
			}
			else{
				z = (curWaypoint == 0) ? (Matrix4x4f) waypoints.elementAt(0) : (Matrix4x4f) waypoints.elementAt(curWaypoint - 1);
				// a = (curWaypoint == 0) ? (Matrix4x4f) waypoints.elementAt(0) : prevCameraMatrix;
				a = (Matrix4x4f) waypoints.elementAt(curWaypoint);
				b = (Matrix4x4f) waypoints.elementAt(curWaypoint + 1);
				c = (curWaypoint + 2 == waypoints.size()) ? (Matrix4x4f) waypoints.elementAt(curWaypoint + 1) : (Matrix4x4f) waypoints.elementAt(curWaypoint + 2);
			}

			// Calculate t
			float t;
			if (isWaypointSoft(a)){
				if (isWaypointSoft(b)){ // Soft to soft
					t = timer/flyTimes[curWaypoint]; // Linear: y = x
				}
				else{ // Soft to hard
					t = (float) (-Math.pow((timer/flyTimes[curWaypoint])-1, 2) + 1); // Parabolic: y = -(x-1)^2 + 1
				}
			}
			else{
				if (isWaypointSoft(b)){ // Hard to soft
					t = (timer/flyTimes[curWaypoint])*(timer/flyTimes[curWaypoint]); // Parabolic: y = x^2
				}
				else{ // Hard to hard
					t = (float) Tools.switchRampC2((double) flyTimes[curWaypoint], 1, (double) flyTimes[curWaypoint]/2, (double) timer); // Cubic -> Inverse Cubic
				}
			}

			// Interpolate translation based on fly mode
			if (linearMode){
				Matrix4x4fMath.lerpTrans(t, a, b, curCameraMatrix);
			}
			else{
				Matrix4x4fMath.berpTrans(t, z, a, b, c, curCameraMatrix);
			}

			// Interpolate/set rotation based on view mode
			Matrix4x4fMath.slerpRot(t, a, b, curCameraMatrix);
			
			// Copy 4th row control values
			Matrix4x4fMath.copyFourthRow(b, curCameraMatrix);

			// Set resulting matrix
			if (preview){
				cameraPreview.setMatrix(curCameraMatrix);
			}
			else{
				flyView.setCameraMatrix(curCameraMatrix);
			}
		}
		
		// If waiting for trigger, will keep timer at 0 to prevent start of flight
		if (preview || !waitForTrigger){
			timer = timer + tick;
		}
	}

	private void handleFlyView(float tick){
		if (preflight){ // Show preflight countdown
			if (timer >= 4.f){
				countdown.setVisible(false);
				preflight = false;
				flying = true;
				timer = 0.f;
			}
			countdown.setTextureAnimationIndex((int) Math.floor((double) timer));
			timer = timer + tick;
		}
		else if (flying){ // Waypoint flights
			doWaypointFlights(tick, false);
		}
		else{ // Setup and start flight
			timer = 0.f;
			curWaypoint = 0;
			sco.setElementsVisible(false);
			flyView.setCameraMatrix((Matrix4x4f) waypoints.elementAt(0));
			if (coasterTrigger != null){
				flying = true;
				waitForTrigger = true;
			}
			else if (skipCountdown){
				flying = true;
			}
			else{
				preflight = true;
				countdown.setMatrix((Matrix4x4f) waypoints.elementAt(0));
				countdown.setVisible(true);
			}
		}
	}
	
	public void onNextFrame(float tick){
		if (!firstInstructionsPrinted){ // Prints the instructions after 1 sec.
			if (timer >= 1.f){
				timer = 0.f;
				printInstructions();
				firstInstructionsPrinted = true;
			}
			timer = timer + tick;
		}

		if (flyView.isActive()){ // Player is in fly view
			handleFlyView(tick);
		}
		else{ // Player is not in fly view
			if (preflight || flying){ // Player just left fly view
				preflight = false;
				flying = false;
				timer = 0.f;
				curWaypoint = 0;
				printInstructions();
			}
			handleButtonPress(tick);
			updatePreviewCameras(tick);
		}
	}
	
	public void onTrainEntering(TrackTrigger trigger, Train train){
		if (trigger == coasterTrigger){
			waitForTrigger = false;
		}
	}
	
	public void onTrainLeaving(TrackTrigger trigger, Train train){
		// Do nothing, but method still needs to be present
	}
}